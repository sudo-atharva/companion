<!-- Companion: timelapse watermark. Rendered as a generic template, then moved into the Timelapse tab by the JS. -->
<div id="companion_timelapse_watermark" style="display: none">
    <h4>Watermark</h4>
    <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
        <div style="background: #444; padding: 8px; border-radius: 6px">
            <img data-bind="attr: {src: imageUrl}" alt="Timelapse watermark" style="max-height: 64px; max-width: 220px; display: block">
        </div>
        <div>
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: enabled, event: {change: saveEnabled}"> Show the watermark in timelapse videos
            </label>
            <div data-bind="visible: canEdit">
                <input type="file" accept="image/png" style="display: none" data-bind="event: {change: upload}" id="companion_watermark_file">
                <button class="btn" data-bind="enable: !busy(), click: pick"><i class="fas fa-upload"></i> Upload image</button>
                <button class="btn" data-bind="enable: !busy(), click: reset"><i class="fas fa-undo"></i> Reset to OctoPrint logo</button>
                <span class="help-block">PNG, transparency works. Shown in the bottom-left corner of new timelapses.
                    <span class="text-error" data-bind="text: message"></span></span>
            </div>
        </div>
    </div>
    <hr>
</div>
